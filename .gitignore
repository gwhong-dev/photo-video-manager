# 설치된 패키지 (npm install로 다시 받을 수 있어요)
node_modules/

# 빌드 결과물 (나중에 exe 만들 때 생겨요)
dist/
out/

# 윈도우/에디터 임시 파일
Thumbs.db
desktop.ini
.vscode/
*.log

# 외부 프로그램 (exiftool, ImageMagick, FFmpeg) — 용량이 커서 저장소에는 안 올려요
tools/

# 비밀 정보 (절대 올리면 안 돼요)
.env
.env.*
*recovery-codes*

# 예전 버전 복사본, 참고용 스크립트 (저장소에는 안 올려요)
version/
참고용 파워쉘/

# 직접 넣는 시험용 사진 (개인 사진·위치 정보가 들어 있어서 저장소에는 안 올려요)
test/samples/manual/

# 썸네일 캐시 (프로그램이 다시 만들 수 있어요)
thumbs/
.thumbs/
*.thumbcache

# Claude Code 개인 설정 (나만 쓰는 설정)
.claude/settings.local.json

# exe 로 만든 결과 (npm run dist, scripts/build-exe.bat 가 만들어요)
release/
