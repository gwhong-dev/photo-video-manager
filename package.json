{
  "name": "photo-video-manager",
  "version": "1.0.0",
  "description": "사진/영상을 변환(HEIC→JPG, MOV→MP4)하고 찍은 날짜로 이름·폴더를 정리하는 Windows 데스크톱 프로그램 (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "samples": "node scripts/make-samples.js",
    "check": "vite build && node scripts/check.js",
    "postinstall": "node node_modules/electron/install.js"
  },
  "keywords": [
    "electron",
    "photo",
    "organizer"
  ],
  "author": "gwhong-dev",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  }
}
